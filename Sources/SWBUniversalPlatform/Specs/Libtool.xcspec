(
    {   Identifier = com.apple.pbx.linkers.libtool;
        Type = Linker;
        Name = "Libtool";
        Description = "Create a static library using Apple Mach-O Librarian (libtool)";
        IsAbstract = Yes;       // This is an internal tool, so we keep it out of the user interface
        BinaryFormats = (mach-o);
        CommandLine = "$(LIBTOOL) [options] [special-args] -o $(OutputPath)";      // 'special-args' includes the input files
        RuleName = "Libtool $(OutputPath) $(CURRENT_VARIANT) $(CURRENT_SLICE_UNVERSIONED)";
        CommandIdentifier = "create:$(OutputPath)";
        ExecDescription = "Create static library $(OutputFile:file)";
        ProgressDescription = "Creating static library";
        InputFileTypes = (
            compiled.mach-o.objfile,
            compiled.object-library
        );
        Outputs = (
            // We're a linker-like task, so we expect to be given an output path in 'OutputPath'.
            "$(OutputPath)"
        );
        CommandOutputParser = XCGccCommandOutputParser;
        Options = (
            // Tool configuration
            {   Name = LIBTOOL;
                Type = Path;
                DefaultValue = "$(LIBTOOL_DRIVER)";
            },
            {
                Name = LIBTOOL_DRIVER;
                Type = Enumeration;
                Values = (
                    libtool,
                    clang,
                );
                DefaultValue = "libtool";
            },

            // Emit a static library
            {
                Name = LIBTOOL_STATIC;
                Type = Enumeration;
                Values = (
                    libtool,
                    clang,
                );
                DefaultValue = "$(LIBTOOL_DRIVER)";
                CommandLineArgs = {
                    "clang" = ( "--emit-static-lib" );
                    "<<otherwise>>" = ( "-static" );
                };
            },

            // Other options may be quoted using -Xstatic-lib-tool for passing to the compiler driver if the driver doesn't understand them.
            // The quote argument will be removed when not using the compiler driver.

            // Architectures & target triples
            {   Name = LIBTOOL_ARCH;
                Type = String;
                DefaultValue = "$(CURRENT_ARCH)";
                CommandLineFlag = "-arch_only";
                Condition = "$(LIBTOOL_DRIVER) == libtool";
            },
            {   Name = LIBTOOL_TARGET_TRIPLE;
                Type = String;
                CommandLineArgs = ( "-target", "$(value)", "--static-lib-target-arch-only" );
                DefaultValue = "$(CURRENT_TARGET_TRIPLE)";
                Condition = "$(LIBTOOL_DRIVER) != libtool";
            },
            {   Name = LIBTOOL_COHORT_ARCHS;
                Type = StringList;
                DefaultValue = "$(COHORT_ARCHS)";
                CommandLineFlag = "-arch_variant";
                Condition = "$(LIBTOOL_DRIVER) == libtool";
            },
            {   Name = LIBTOOL_COHORT_ARCHS_CLANG;
                Type = StringList;
                DefaultValue = "$(LIBTOOL_COHORT_ARCHS)";
                CommandLineFlag = "-target-arch-variant";
                Condition = "$(LIBTOOL_DRIVER) != libtool";
            },

            {   Name = LIBTOOL_DETERMINISTIC_MODE;
                Type = Boolean;
                DefaultValue = YES;
                CommandLineFlag = "-D";
                Condition = "$(LIBTOOL_DRIVER) == libtool";
            },
            {   Name = LIBTOOL_DETERMINISTIC_MODE_CLANG;
                Type = Boolean;
                DefaultValue = "$(LIBTOOL_DETERMINISTIC_MODE)";
                CommandLineArgs = {
                    YES = ("--static-lib-deterministic");
                    NO = ("--no-static-lib-deterministic");
                };
                Condition = "$(LIBTOOL_DRIVER) != libtool";
            },

            // SDK
            {   Name = LIBTOOL_SDKROOT_SYSLIBROOT;
                Type = Path;
                DefaultValue = "$(SDKROOT)";
                CommandLineFlag = "-syslibroot";
                Condition = "$(LIBTOOL_DRIVER) == libtool";
                IsInputDependency = Yes;
            },
            {   Name = LIBTOOL_SDKROOT_ISYSROOT;
                Type = Path;
                DefaultValue = "$(SDKROOT)";
                CommandLineFlag = "-isysroot";
                Condition = "$(LIBTOOL_DRIVER) != libtool";
                IsInputDependency = Yes;
            },

            // Search paths
            {   Name = LIBRARY_SEARCH_PATHS;
                Type = PathList;
                FlattenRecursiveSearchPathsInValue = Yes;   // causes any paths that have a '/**' suffix to be replaced with matching paths
                CommandLinePrefixFlag = "-L";
            },

            // Input file lists
            {   Name = __INPUT_FILE_LIST_PATH__;
                Type = Path;
                Condition = "$(LIBTOOL_USE_RESPONSE_FILE)";
                DefaultValue = "$(LINK_FILE_LIST_$(CURRENT_VARIANT)_$(CURRENT_SLICE_UNVERSIONED))";      // this is set up for us as a read-only property
                CommandLineFlag = "-filelist";
                IsInputDependency = Yes;
            },

            // Various flags
            {   Name = ALL_OTHER_LIBTOOLFLAGS;
                Type = StringList;
                DefaultValue = "$(OTHER_LIBTOOLFLAGS) $(OTHER_LIBTOOLFLAGS_$(CURRENT_VARIANT)) $(OTHER_LIBTOOLFLAGS_$(CURRENT_ARCH)) $(OTHER_LIBTOOLFLAGS_$(CURRENT_VARIANT)_$(CURRENT_ARCH)) $(PRODUCT_SPECIFIC_LIBTOOLFLAGS)";
                DefaultValue = "$(OTHER_LIBTOOLFLAGS) $(OTHER_LIBTOOLFLAGS_$(CURRENT_VARIANT)) $(OTHER_LIBTOOLFLAGS_$(CURRENT_ARCH)) $(OTHER_LIBTOOLFLAGS_$(CURRENT_VARIANT)_$(CURRENT_ARCH)) $(PRODUCT_SPECIFIC_LIBTOOLFLAGS)";
                CommandLinePrefixFlag = "";
            },
            {   Name = EXPORTED_SYMBOLS_FILE;
                Type = Path;
                Condition = "!$(SEPARATE_SYMBOL_EDIT)";
                CommandLineArgs = {
                    "" = ();
                    "<<otherwise>>" = ("-Xstatic-lib-tool", "-exported_symbols_list", "-Xstatic-lib-tool", "$(value)");
                };
                IsInputDependency = Yes;
                ConditionFlavors = ( "arch" );
            },
            {   Name = UNEXPORTED_SYMBOLS_FILE;
                Type = Path;
                Condition = "!$(SEPARATE_SYMBOL_EDIT)";
                CommandLineArgs = {
                    "" = ();
                    "<<otherwise>>" = ("-Xstatic-lib-tool", "-unexported_symbols_list", "-Xstatic-lib-tool", "$(value)");
                };
                IsInputDependency = Yes;
                ConditionFlavors = ( "arch" );
            },
            {   Name = AdditionalCommandLineArguments;
                Type = StringList;
                CommandLinePrefixFlag = "";
            },

            {   Name = LIBTOOL_DEPLOYMENT_TARGET;
                Type = String;
                DefaultValue = "$($(DEPLOYMENT_TARGET_SETTING_NAME))";
                SetValueInEnvironmentVariable = "$(DEPLOYMENT_TARGET_CLANG_ENV_NAME)";
            },

            // Dependency info file
            {
                Name = "LIBTOOL_DEPENDENCY_INFO_FILE";
                Type = Path;
                DefaultValue = "$(OBJECT_FILE_DIR_$(CURRENT_VARIANT))/$(CURRENT_SLICE_UNVERSIONED)/$(PRODUCT_NAME)_libtool_dependency_info.dat";
            },

            {
                Name = "LIBTOOL_USE_RESPONSE_FILE";
                Type = Boolean;
                DefaultValue = YES;
            },
            {
                Name = "LIBTOOL_FILE_LIST_FORMAT";
                Type = Enumeration;
                Values = (
                    unescapedNewlineSeparated,
                    unixShellQuotedSpaceSeparated,
                    unixShellQuotedNewlineSeparated,
                    windowsShellQuotedNewlineSeparated,
                );
                DefaultValue = unescapedNewlineSeparated;
            },
        );
    }
)
