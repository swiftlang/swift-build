(
    // The bare-metal Mach-O platform has no fixed set of architectures: the SDK (for example a Swift SDK) provides them.
    {
        Domain = none-macho;
        Type = Architecture;
        Identifier = Standard;
        Name = "Standard Architectures";
        Description = "Standard architectures";
        ArchitectureSetting = "ARCHS_STANDARD";
        RealArchitectures = (
            "$(VALID_ARCHS)"
        );
        SortNumber = 0;
    },
)
